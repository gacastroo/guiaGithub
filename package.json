{
  "name": "@gacastroo/guia-github",
  "version": "1.0.2",
  "description": "Guía visual de Git y GitHub para principiantes, desarrollada con HTML, CSS y JavaScript.",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "npm run dev",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:html": "htmlhint \"index.html\" \"assets/html/**/*.html\"",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:js": "eslint \"assets/js/**/*.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "package": "node scripts/create-package.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "echo \"No tests configured\"",
    "check": "npm run format:check && npm run lint",
    "package:dry": "npm pack --dry-run"
  },
  "keywords": [
    "git",
    "github",
    "html",
    "css",
    "javascript",
    "guia"
  ],
  "author": "Guillermo Castro Abarca",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "archiver": "^7.0.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "htmlhint": "^1.1.4",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^6.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gacastroo/guiaGithub.git"
  },
  "homepage": "https://gacastroo.github.io/guiaGithub/",
  "bugs": {
    "url": "https://github.com/gacastroo/guiaGithub/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "index.html",
    "assets/",
    "_headers",
    "README.md",
    "PACKAGE-USAGE.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
